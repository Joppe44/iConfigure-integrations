{{ 'ed-configurator.css' | asset_url | stylesheet_tag }}

<style>
  .ed-footer {
    display: none !important;
  }

  /* Ensure header stays on top of configurator */
  .shopify-section-group-header-group {
    position: relative !important;
    z-index: 10000 !important;
  }
</style>

<div class="ed-configurator color-{{ section.settings.color_scheme }}{% if section.settings.disable_padding %} no-padding{% endif %}">
  <div>
    <div class="row">
      <div class="col-12">
        <div id="configurator-container" style="position: relative; width: 100%;">
          {%- if page.handle == 'configurator' -%}
          <script>
            // Load configurator in iframe to isolate CSS
            (function() {
              const container = document.getElementById('configurator-container');

              // Get URL parameters
              const params = new URLSearchParams(window.location.search);
              const hoogte = params.get('hoogte') || '240';
              const breedte = params.get('breedte') || '210';
              const diepte = params.get('diepte') || '60';
              const configuratorUrl = new URL({{ section.settings.configurator_url | default: 'https://configurator.iconfigure.io/?product=3139b1fc-842f-4742-9130-17272cc60fd3' | json }});
              configuratorUrl.searchParams.set('hoogte', hoogte);
              configuratorUrl.searchParams.set('breedte', breedte);
              configuratorUrl.searchParams.set('diepte', diepte);

              // Create iframe
              const iframe = document.createElement('iframe');
              iframe.style.width = '100%';
              iframe.style.border = 'none';
              iframe.title = 'Configurator';

              iframe.src = configuratorUrl.toString();
              container.appendChild(iframe);
            })();
          </script>
          {%- endif -%}
          <script>
            // GTM tracking preserved for new configurator script
            window.dataLayer = window.dataLayer || [];

            function pushConfiguratorEvent(eventName, payload = {}) {
              window.dataLayer.push({
                event: eventName,
                ...payload,
              });
            }

            function normalizeCustomerData(data = {}) {
              const address = data.address || {};

              return {
                address: {
                  street: address.street || '',
                  city: address.city || '',
                  zip: address.zip || '',
                  country: address.country || '',
                },
                phone: data.phone || '',
                email: data.email || '',
                last_name: data.lastName || '',
                sur_name: data.firstName || '',
              };
            }

            const completePageUrl = {{ section.settings.complete_page.url | json }};
            let capturedEmail = '';
            let capturedFormData = {};
            let redirectScheduled = false;

            function updateCapturedDetails(data = {}) {
              if (data.email) {
                capturedEmail = data.email;
              }

              if (data.formData && typeof data.formData === 'object') {
                capturedFormData = Object.assign({}, capturedFormData, data.formData);

                if (!capturedEmail) {
                  Object.keys(data.formData).forEach(function(key) {
                    if (!key) {
                      return;
                    }

                    if (key.toLowerCase().includes('mail') && data.formData[key]) {
                      const candidate = String(data.formData[key]).trim();
                      const match = candidate.match(EMAIL_REGEX);
                      if (match && match[0]) {
                        capturedEmail = match[0];
                      }
                    }
                  });
                }
              }

              if (!capturedEmail) {
                const deepEmail = deepFindEmail(data);
                if (deepEmail) {
                  capturedEmail = deepEmail;
                }
              }
            }

            function buildCustomerPayload(data = {}) {
              const customerData = normalizeCustomerData(data);

              if (!customerData.email && capturedEmail) {
                customerData.email = capturedEmail;
              }

              return customerData;
            }

            function redirectToCompletePage() {
              if (!completePageUrl || redirectScheduled) {
                return;
              }

              redirectScheduled = true;
              setTimeout(function() {
                window.location.href = completePageUrl;
              }, 150);
            }

            const EMAIL_REGEX = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i;

            function deepFindEmail(value, maxDepth = 6) {
              const visited = new Set();

              function walk(node, depth) {
                if (!node || depth > maxDepth) {
                  return '';
                }

                if (typeof node === 'string') {
                  const match = node.match(EMAIL_REGEX);
                  return match && match[0] ? match[0] : '';
                }

                if (typeof node !== 'object') {
                  return '';
                }

                if (visited.has(node)) {
                  return '';
                }

                visited.add(node);

                if (Array.isArray(node)) {
                  for (let i = 0; i < node.length; i++) {
                    const found = walk(node[i], depth + 1);
                    if (found) {
                      return found;
                    }
                  }
                  return '';
                }

                for (const key in node) {
                  if (!Object.prototype.hasOwnProperty.call(node, key)) {
                    continue;
                  }

                  const found = walk(node[key], depth + 1);
                  if (found) {
                    return found;
                  }
                }

                return '';
              }

              return walk(value, 0);
            }

            function findEmailInElementValues(root) {
              if (!root || !root.querySelectorAll) {
                return '';
              }

              const elements = root.querySelectorAll('input, textarea');
              for (let i = 0; i < elements.length; i++) {
                const el = elements[i];
                const value = (el && typeof el.value === 'string' ? el.value : '').trim();

                if (!value) {
                  continue;
                }

                const match = value.match(EMAIL_REGEX);
                if (match && match[0]) {
                  return match[0];
                }
              }

              return '';
            }

            function tryCaptureEmailFromDom(source) {
              let foundEmail = '';

              // 1) Scan inside configurator iframe (srcdoc => same-origin)
              const iframe = document.querySelector('#configurator-container iframe');
              if (iframe) {
                try {
                  const iframeDoc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
                  const iframeRoot = iframeDoc && (iframeDoc.getElementById('iConfigure') || iframeDoc.body);
                  foundEmail = findEmailInElementValues(iframeRoot);
                } catch (err) {
                  // ignore
                }
              }

              // 2) Fallback: scan any iConfigure inputs that might be teleported to parent DOM
              if (!foundEmail) {
                const parentRoot = document.getElementById('configurator-container') || document.body;
                foundEmail = findEmailInElementValues(parentRoot);
              }

              if (foundEmail && foundEmail !== capturedEmail) {
                capturedEmail = foundEmail;
                console.log('[Configurator Parent] Email captured from DOM:', capturedEmail, 'source:', source);
              }
            }

            function startEmailPolling() {
              if (window.__configuratorEmailPollingStarted) {
                return;
              }

              const iframe = document.querySelector('#configurator-container iframe');
              if (!iframe) {
                return;
              }

              window.__configuratorEmailPollingStarted = true;

              let attempts = 0;
              const maxAttempts = 1200; // ~10 minutes @ 500ms
              const poll = function() {
                attempts += 1;
                tryCaptureEmailFromDom('poll');

                if (capturedEmail || attempts >= maxAttempts) {
                  clearInterval(timer);
                }
              };

              const timer = setInterval(poll, 500);
              poll();
            }

            // Start polling for email as soon as iframe exists
            startEmailPolling();

            // Listen for configurator events from new script
            // The new kastenland.js script will trigger events that we can listen to
            window.addEventListener("message", function (event) {
              // Debug: log ALL messages received
              console.log('[Configurator Parent] Message received:', event.data, 'from:', event.origin);

              // Listen for events from iconfigure domain
              if (!event.data) {
                return;
              }

              const message = event.data;
              const data = message.data || message;
              const type = message.type || message.action || message.name || data.type || data.action || data.name || '';
              const state = data.state || message.state || '';
              const items = data.items || [];
              const updates = data.updates || [];
              const dealerId = data.dealerId || data.dealer_id || null;
              const productId = data.productId || data.product_id || null;
              const totalPrice = data.totalPrice || data.total_price || null;
              const timePayload = data.time || data.transactionId || null;
              const totalPayload = data.total || totalPrice || null;

              updateCapturedDetails(data);

              // Try to find email in message payload deeply
              const deepEmail = deepFindEmail(message) || deepFindEmail(data);
              if (deepEmail && deepEmail !== capturedEmail) {
                capturedEmail = deepEmail;
                console.log('[Configurator Parent] Email found in message payload:', capturedEmail);
              }

              // Also try DOM scraping
              tryCaptureEmailFromDom('message');

              switch (type) {
                case 'ic_setup':
                  pushConfiguratorEvent('ic_setup', {
                    data: {
                      product_id: productId,
                      dealer_id: dealerId,
                      time: timePayload,
                      updates,
                    },
                    items,
                  });
                  break;

                case 'ic_update':
                  pushConfiguratorEvent('ic_update', {
                    data: {
                      product_id: productId,
                      dealer_id: dealerId,
                      time: timePayload,
                      updates,
                    },
                    items,
                    total_price: totalPrice,
                  });
                  break;

                case 'ic_finish':
                  pushConfiguratorEvent('ic_finish', {
                    data: {
                      product_id: productId,
                      dealer_id: dealerId,
                      time: timePayload,
                      updates,
                    },
                    items,
                    total_price: totalPrice,
                    ...buildCustomerPayload(data),
                  });
                  break;

                case 'offerte_submit':
                  tryCaptureEmailFromDom('offerte_submit');
                  pushConfiguratorEvent('offerte_submit', {
                    total_price: totalPrice,
                    Transaction_id: data.transactionId || timePayload,
                    items,
                    ...buildCustomerPayload(data),
                    formData: data.formData || capturedFormData,
                  });
                  redirectToCompletePage();
                  break;

                case 'configurator_form_submit':
                  // Just capture email internally, don't push to GTM (only configurator_completed will fire)
                  console.log('[Configurator] Form submitted with email:', data.email || capturedEmail);
                  break;

                case 'configurator_email_capture_internal':
                  // Email captured inside iframe - update parent state but don't push to GTM
                  if (data.email && data.email !== capturedEmail) {
                    capturedEmail = data.email;
                    console.log('[Configurator] Email captured internally:', capturedEmail, 'source:', data.source);
                  }
                  break;

                case 'configurator_completed':
                  // Configurator detected completion state - send to GTM and redirect
                  tryCaptureEmailFromDom('completed');
                  const completedDeepEmail = deepFindEmail(message) || deepFindEmail(data);
                  if (completedDeepEmail && completedDeepEmail !== capturedEmail) {
                    capturedEmail = completedDeepEmail;
                  }
                  pushConfiguratorEvent('configurator_completed', {
                    email: data.email || capturedEmail,
                    formData: data.formData || capturedFormData,
                    total: totalPayload,
                  });
                  console.log('[Configurator] Completed with email:', data.email || capturedEmail);
                  redirectToCompletePage();
                  break;

                default:
                  if (state === 'finished') {
                    tryCaptureEmailFromDom('finished');
                    pushConfiguratorEvent('configurator_completed', {
                      total: totalPayload,
                      product_id: productId,
                      email: data.email || capturedEmail,
                      formData: data.formData || capturedFormData,
                    });

                    redirectToCompletePage();
                  }
              }
            });

            // Also listen for custom events that might be dispatched by the new script
            document.addEventListener('configurator:setup', function(e) {
              pushConfiguratorEvent('ic_setup', e.detail || {});
            });

            document.addEventListener('configurator:update', function(e) {
              pushConfiguratorEvent('ic_update', e.detail || {});
            });

            document.addEventListener('configurator:finish', function(e) {
              pushConfiguratorEvent('ic_finish', e.detail || {});
              redirectToCompletePage();
            });

            document.addEventListener('configurator:submit', function(e) {
              pushConfiguratorEvent('offerte_submit', e.detail || {});
              redirectToCompletePage();
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Configurator",
  "tag": "section",
  "class": "ed-configurator-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "disable_padding",
      "label": "Section spacing",
      "info": "Enable this option to reduce the spacing on the top and bottom of the section."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "configurator_url",
      "label": "Configurator url"
    },
    {
      "type": "text",
      "id": "configurator_title",
      "label": "Configurator title"
    },
    {
      "type": "page",
      "id": "complete_page",
      "label": "Bedankt pagina"
    }
  ],
  "presets": [
    {
      "name": "Configurator"
    }
  ]
}
{% endschema %}
