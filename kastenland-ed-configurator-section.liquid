<div class="ed-configurator color-{{ section.settings.color_scheme }}{% if section.settings.disable_padding %} no-padding{% endif %}">
  <div id="iConfigure"></div>
</div>

{%- if page.handle == 'configurator' -%}
  <script src="https://scripts.iconfigure.nl/kastenland.js?1" crossorigin="anonymous" defer></script>
{%- endif -%}

<script>
  window.dataLayer = window.dataLayer || [];

  (function () {
    var completePageUrl = {{ section.settings.complete_page.url | json }};
    var redirectScheduled = false;

    function pushConfiguratorEvent(eventName, payload) {
      window.dataLayer.push(Object.assign({ event: eventName }, payload || {}));
    }

    function redirectToCompletePage() {
      if (!completePageUrl || redirectScheduled) return;
      redirectScheduled = true;
      setTimeout(function () {
        window.location.href = completePageUrl;
      }, 150);
    }

    window.addEventListener('message', function (event) {
      var data = event.data;
      if (!data || typeof data !== 'object') return;

      var productId = data.productId || data.product_id || null;
      var totalPrice = data.total || data.totalPrice || data.total_price || null;

      if (data.name === 'quotation' && data.state === 'finished') {
        pushConfiguratorEvent('offerte_submit', {
          total_price: totalPrice,
          Transaction_id: data.quotation_id || null,
          product_id: productId,
          pdf_url: data.pdf_url || null,
        });
        pushConfiguratorEvent('configurator_completed', {
          total: totalPrice,
          product_id: productId,
        });
        redirectToCompletePage();
        return;
      }

      if (data.name === 'cart.action' && data.state === 'finished') {
        pushConfiguratorEvent('cart_action', {
          product_id: productId,
          dealer_id: data.dealer_id || null,
          items: data.items || [],
          extra_fields: data.extra_fields || {},
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Configurator",
  "tag": "section",
  "class": "ed-configurator-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "disable_padding",
      "label": "Section spacing",
      "info": "Enable this option to reduce the spacing on the top and bottom of the section."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "configurator_url",
      "label": "Configurator url"
    },
    {
      "type": "text",
      "id": "configurator_title",
      "label": "Configurator title"
    },
    {
      "type": "page",
      "id": "complete_page",
      "label": "Bedankt pagina"
    }
  ],
  "presets": [
    {
      "name": "Configurator"
    }
  ]
}
{% endschema %}
